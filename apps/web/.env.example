# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# Auth (better-auth)
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# Cloudinary (only needed for scripts/upload-videos-cloudinary.ts)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
